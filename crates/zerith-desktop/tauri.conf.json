{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerith",
  "version": "0.2.0",
  "identifier": "com.zerith.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "frontend"
    },
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "frontend"
    },
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zerith",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "create": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../bundled-skills": "bundled-skills"
    }
  }
}
